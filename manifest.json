{
  "manifest_version": 3,
  "name": "墨笺 InkNote — Markdown Reader",
  "short_name": "InkNote",
  "version": "2.1.0",
  "description": "专业 Markdown 阅读器。支持 LaTeX 数学公式、Mermaid 图表、TTS 朗读、AI 翻译、高亮标注、大纲导航、编辑模式。",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "打开墨笺",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
